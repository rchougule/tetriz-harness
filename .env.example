# Environment-variable template for the standalone reference host. Export these variables
# into the server process; the host does not load .env files automatically. Docker Compose
# uses docker-compose.yml and the directory JSON instead. Replace local-only credentials
# in the actual deployment configuration before exposing it beyond localhost.
# docker-compose.yml ships LOCAL-ONLY defaults for all of these.

# Postgres connection string (required).
HARNESS_DATABASE_URL=postgres://harness:change-me@postgres:5432/harness?sslmode=disable

# JSON file of people, teams, the admin token and device tokens (required).
# cmd/harnessctl-server/directory.local.json is a LOCAL-ONLY sample (person
# dev-1, team platform, admin token local-only-admin-token, device token
# local-only-device-token). Write your own for anything else, storing tokens as
# "sha256:<hex digest>" to keep the secrets out of the file.
HARNESS_DIRECTORY_FILE=/etc/harness/directory.json

HARNESS_LISTEN_ADDR=:8080

# Body store: fs (default) or s3.
HARNESS_BLOB_BACKEND=fs
HARNESS_BLOB_DIR=/data/blobs

# s3 backend (MinIO or AWS S3). Empty access keys use the instance role.
# HARNESS_S3_ENDPOINT=minio:9000
# HARNESS_S3_BUCKET=harness-blobs
# HARNESS_S3_REGION=us-east-1
# HARNESS_S3_ACCESS_KEY=
# HARNESS_S3_SECRET_KEY=
# HARNESS_S3_USE_SSL=false
# HARNESS_S3_PREFIX=

# Hook artifacts run code on every targeted machine; off unless set to true.
HARNESS_ALLOW_HOOKS=false
